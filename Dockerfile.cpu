FROM rust:1.88-bookworm AS build

WORKDIR /app
COPY . .
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
ENV ORT_LIB_LOCATION=/opt/ort
RUN cargo build --locked -p kernelport-server --release

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libstdc++6 \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --break-system-packages \
        huggingface_hub==0.20.3 \
        pyyaml==6.0.1 \
        onnxruntime==1.22.0

RUN mkdir -p /opt/ort && python3 -c 'import onnxruntime, pathlib, os; os.symlink(next((pathlib.Path(onnxruntime.__file__).parent / "capi").glob("libonnxruntime.so*")), "/opt/ort/libonnxruntime.so")'
ENV ORT_DYLIB_PATH=/opt/ort/libonnxruntime.so

WORKDIR /app
COPY --from=build /app/target/release/kernelportd /app/kernelportd
COPY scripts /app/scripts

RUN chmod +x /app/scripts/entrypoint.sh && /app/kernelportd --help

ENTRYPOINT ["/app/scripts/entrypoint.sh"]
CMD ["--device", "cpu"]
